=1;aspect=fixed;fillColor=#D13438;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=9;shadow=1;" vertex="1" parent="1"><mxGeometry x="680" y="456" width="26" height="26" as="geometry"/></mxCell><mxCell id="f3" value="F3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D13438;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=9;shadow=1;" vertex="1" parent="1"><mxGeometry x="1110" y="293" width="26" height="26" as="geometry"/></mxCell><mxCell id="zones" value="&lt;b&gt;Private DNS zones&lt;/b&gt; (rg-dnsfo-shared, linked to both hubs)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8886;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#323130;spacingLeft=52;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1545" y="80" width="235" height="300" as="geometry"/></mxCell><mxCell id="zi" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/DNS_Zones.svg" vertex="1" parent="zones"><mxGeometry x="8" y="10" width="36" height="36" as="geometry"/></mxCell><mxCell id="zl" value="&amp;bull; azure.contoso.internal&lt;br&gt;&amp;nbsp;&amp;nbsp;app1 &amp;rarr; 10.50.0.1 (TTL 10 s)&lt;br&gt;&amp;nbsp;&amp;nbsp;app2 &amp;rarr; 10.50.0.2 (TTL 3600 s)&lt;br&gt;&lt;br&gt;&amp;bull; privatelink.blob.core.windows.net&lt;br&gt;&lt;br&gt;&amp;bull; lab.contoso.internal (per region)&lt;br&gt;&amp;nbsp;&amp;nbsp;whoami &amp;rarr; 10.255.1.1 / 10.255.2.2&lt;br&gt;&amp;nbsp;&amp;nbsp;(reveals which resolver answered)&lt;br&gt;&lt;br&gt;&amp;bull; Ruleset: onprem.contoso.internal &amp;rarr; dnsmasq" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#323130;" vertex="1" parent="zones"><mxGeometry x="10" y="60" width="220" height="230" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8886;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#323130;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1545" y="400" width="235" height="300" as="geometry"/></mxCell><mxCell id="lgt0" value="VNet peering" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#323130;" vertex="1" parent="1"><mxGeometry x="1615" y="432" width="160" height="20" as="geometry"/></mxCell><mxCell id="lgt1" value="Hybrid link (peering / VPN)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#323130;" vertex="1" parent="1"><mxGeometry x="1615" y="462" width="160" height="20" as="geometry"/></mxCell><mxCell id="lgt2" value="DNS query (primary path)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#323130;" vertex="1" parent="1"><mxGeometry x="1615" y="492" width="160" height="20" as="geometry"/></mxCell><mxCell id="lgt3" value="Cross-region traffic via NVAs" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#323130;" vertex="1" parent="1"><mxGeometry x="1615" y="522" width="160" height="20" as="geometry"/></mxCell><mxCell id="lgf" value="F1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D13438;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=9;shadow=1;" vertex="1" parent="1"><mxGeometry x="1569" y="554" width="22" height="22" as="geometry"/></mxCell><mxCell id="lgft" value="F1 inbound endpoint down (NSG deny 53)&lt;br&gt;F2 hub-hub peering removed&lt;br&gt;F3 NVA r1 down" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#323130;" vertex="1" parent="1"><mxGeometry x="1615" y="550" width="165" height="60" as="geometry"/></mxCell><mxCell id="lgn" value="Production: replace the Linux NVAs with Azure Firewall or redundant NVAs behind an internal Load Balancer." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#323130;fontColor=#A4262C;" vertex="1" parent="1"><mxGeometry x="1555" y="622" width="220" height="70" as="geometry"/></mxCell><mxCell id="st0" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="985" width="32" height="32" as="geometry"/></mxCell><mxCell id="stt0" value="&lt;b&gt;Normal&lt;/b&gt;&lt;br&gt;Clients query the &lt;b&gt;local&lt;/b&gt; inbound endpoint (first DNS server). BIND forwards to the local endpoint first. Answers come from the local region (whoami 10.255.1.1 in r1)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#323130;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="975" width="530" height="90" as="geometry"/></mxCell><mxCell id="st1" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="985" width="32" height="32" as="geometry"/></mxCell><mxCell id="stt1" value="&lt;b&gt;Failover&lt;/b&gt;&lt;br&gt;Local inbound endpoint unreachable &amp;rarr; clients and BIND retry the &lt;b&gt;remote&lt;/b&gt; endpoint across hub peering via the NVAs. Linux &amp;asymp; 5 s, Windows 17&amp;ndash;56 s, BIND &amp;lt; 1 s worst gap; 100% success." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#323130;fontSize=11;" vertex="1" parent="1"><mxGeometry x="652" y="975" width="530" height="90" as="geometry"/></mxCell><mxCell id="st2" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="985" width="32" height="32" as="geometry"/></mxCell><mxCell id="stt2" value="&lt;b&gt;Failback&lt;/b&gt;&lt;br&gt;When the local endpoint returns, the next queries use the first DNS server again &amp;ndash; no manual action, no sticky state, no zone or ruleset changes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#323130;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1242" y="975" width="530" height="90" as="geometry"/></mxCell><mxCell id="e_hs1" value="Peering" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#0078D4;fontColor=#0078D4;strokeWidth=2.5;startArrow=block;startFill=1;" edge="1" parent="1" source="hub1" target="spk1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_oh1" value="Peering (default)&lt;br&gt;or S2S VPN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#5C2D91;fontColor=#5C2D91;strokeWidth=2.5;startArrow=block;startFill=1;" edge="1" parent="1" source="site1" target="hub1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_q1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#107C10;fontColor=#107C10;strokeWidth=2;" edge="1" parent="1" source="cli1" target="in1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1357" y="165"/><mxPoint x="632" y="165"/></Array></mxGeometry></mxCell><mxCell id="e_b1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#107C10;fontColor=#107C10;strokeWidth=2;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="site1dns" target="in1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="220" y="165"/><mxPoint x="632" y="165"/></Array></mxGeometry></mxCell><mxCell id="e_hs2" value="Peering" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#0078D4;fontColor=#0078D4;strokeWidth=2.5;startArrow=block;startFill=1;" edge="1" parent="1" source="hub2" target="spk2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_oh2" value="Peering (default)&lt;br&gt;or S2S VPN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#5C2D91;fontColor=#5C2D91;strokeWidth=2.5;startArrow=block;startFill=1;" edge="1" parent="1" source="site2" target="hub2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_q2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#107C10;fontColor=#107C10;strokeWidth=2;" edge="1" parent="1" source="cli2" target="in2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1357" y="615"/><mxPoint x="632" y="615"/></Array></mxGeometry></mxCell><mxCell id="e_b2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#107C10;fontColor=#107C10;strokeWidth=2;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="site2dns" target="in2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="220" y="615"/><mxPoint x="632" y="615"/></Array></mxGeometry></mxCell><mxCell id="e_hh" value="Global VNet peering&lt;br&gt;(hub &amp;harr; hub only)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#0078D4;fontColor=#0078D4;strokeWidth=3;exitX=0.3;exitY=1;entryX=0.3;entryY=0;startArrow=block;startFill=1;" edge="1" parent="1" source="hub1" target="hub2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_nva" value="Cross-region path&lt;br&gt;NVA r1 &amp;harr; NVA r2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#CA5010;fontColor=#CA5010;strokeWidth=2.5;dashed=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;startArrow=block;startFill=1;" edge="1" parent="1" source="nva1" target="nva2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1185" y="330"/><mxPoint x="1185" y="780"/></Array></mxGeometry></mxCell><mxCell id="lg0" value="" style="html=1;strokeWidth=2.5;strokeColor=#0078D4;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1557" y="440" as="sourcePoint"/><mxPoint x="1607" y="440" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg1" value="" style="html=1;strokeWidth=2.5;strokeColor=#5C2D91;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1557" y="470" as="sourcePoint"/><mxPoint x="1607" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg2" value="" style="html=1;strokeWidth=2.5;strokeColor=#107C10;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1557" y="500" as="sourcePoint"/><mxPoint x="1607" y="500" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg3" value="" style="html=1;strokeWidth=2.5;strokeColor=#CA5010;dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1557" y="530" as="sourcePoint"/><mxPoint x="1607" y="530" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>