<mxfile host="drawio" type="device"><diagram id="lab" name="DNS Private Resolver failover lab"><mxGraphModel dx="1800" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1150" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style='font-size:20px'&gt;Azure DNS Private Resolver — regional failover lab&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#605E5C'&gt;Azure-to-Azure name resolution · four client designs (A–D) · six failure injections (F1–F6) · every probe result ingested into Log Analytics&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1760" height="50" as="geometry"/></mxCell><mxCell id="reg1" value="Region r1 · East US 2  (rg-dnsfo-r1)" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#323130;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1180" height="810" as="geometry"/></mxCell><mxCell id="spoke_a" value="Spoke A · Design A" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=52;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#201F1E;container=1;collapsible=0;" vertex="1" parent="reg1"><mxGeometry x="20" y="35" width="400" height="180" as="geometry"/></mxCell><mxCell id="spoke_a_ic" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Virtual_Networks.svg" vertex="1" parent="spoke_a"><mxGeometry x="10" y="8" width="34" height="34" as="geometry"/></mxCell><mxCell id="spoke_a_t" value="&lt;i&gt;Azure-provided DNS + rule