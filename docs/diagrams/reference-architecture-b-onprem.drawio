eometry x="55" y="25" width="34" height="34" as="geometry"/></mxCell><mxCell id="rs1" value="&lt;b&gt;Ruleset (production)&lt;/b&gt;&lt;br&gt;onprem.contoso.internal → on-prem DNS servers (both locations)&lt;br&gt;&lt;i&gt;not wired in the lab&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8886;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#323130;strokeColor=#605E5C;dashed=1;" vertex="1" parent="sn_out1"><mxGeometry x="145" y="20" width="195" height="75" as="geometry"/></mxCell><mxCell id="spokeb" value="vnet-dnsfo-spoke-b · 10.11.1.0/24" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=52;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#201F1E;container=1;collapsible=0;" vertex="1" parent="reg1"><mxGeometry x="420" y="35" width="255" height="370" as="geometry"/></mxCell><mxCell id="spokeb_ic" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Virtual_Networks.svg" vertex="1" parent="spokeb"><mxGeometry x="10" y="7" width="34" height="34" as="geometry"/></mxCell><mxCell id="spokeb_t" value="&lt;b&gt;VNet DNS servers (custom)&lt;/b&gt;&lt;br&gt;1. 10.10.0.4 — IE1 (primary)&lt;br&gt;2. 10.20.0.4 — IE2 (secondary)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8886;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#323130;strokeColor=#0078D4;" vertex="1" parent="spokeb"><mxGeometry x="15" y="60" width="225" height="62" as="geometry"/></mxCell><mxCell id="vm_lnx_b" value="&lt;b&gt;vm-dnsfo-lnx-b&lt;/b&gt;&lt;br&gt;Linux probe" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Virtual_Machine.svg" vertex="1" parent="spokeb"><mxGeometry x="4