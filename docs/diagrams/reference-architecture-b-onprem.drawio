calAlign=top;image=img/lib/azure2/networking/DNS_Private_Resolver.svg" vertex="1" parent="hub2"><mxGeometry x="310" y="7" width="40" height="40" as="geometry"/></mxCell><mxCell id="sn_in2" value="&lt;b&gt;snet-dns-inbound&lt;/b&gt; · 10.20.0.0/28" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5FAFF;strokeColor=#8A8886;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=10;fontColor=#323130;container=1;collapsible=0;" vertex="1" parent="hub2"><mxGeometry x="15" y="70" width="350" height="125" as="geometry"/></mxCell><mxCell id="ie2" value="&lt;b&gt;Inbound endpoint — IE2&lt;/b&gt;&lt;br&gt;10.20.0.4 (static)" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/DNS_Private_Resolver.svg" vertex="1" parent="sn_in2"><mxGeometry x="55" y="30" width="42" height="42" as="geometry"/></mxCell><mxCell id="nsg_in2" value="nsg-dns-inbound" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Network_Security_Groups.svg" vertex="1" parent="sn_in2"><mxGeometry x="245" y="75" width="30" height="30" as="geometry"/></mxCell><mxCell id="sn_out2" value="&lt;b&gt;snet-dns-outbound&lt;/b&gt; · 10.20.0.16/28" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5FAFF;strokeColor=#8A8886;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=10;fontColor=#323130;container=1;collapsible=0;" vertex="1" parent="hub2"><mxGeometry x="15" y="205" width="350" height="150" as="geometry"/></mxCell><mxCell id="out2" value="&lt;b&gt;Outbound endpoint&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/DNS_Private_Resolver.svg" vertex="1" parent="sn_out2"><mxGeometry x="55" y="25" width="34" height="34" as="geometry"/></mxCell><mxCell id="rs2" value="&lt;b&gt;Ruleset (production)&lt;/b&gt;&lt;br&gt;onprem.contoso.internal → on-prem DNS servers (both locations)&lt;br&gt;&lt;i&gt;not wired in the lab&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8886;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#323130;strokeColor=#605E5C;dashed=1;" vertex="1" parent="sn_out2"><mxGeometry x="145" y="20" width="195" height="75" as="geometry"/></mxCell><mxCell id="r2_note" value="&lt;b&gt;Standby region&lt;/b&gt;&lt;br&gt;Same resolver build as r1, deployed active-active. IE2 answers from the same global private DNS zones, so answers are identical.&lt;br&gt;&lt;br&gt;Workload spokes in r2 mirror spoke B with the order reversed: &lt;b&gt;[IE2, IE1]&lt;/b&gt;." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8886;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#323130;strokeColor=#0078D4;" vertex="1" parent="reg2"><mxGeometry x="420" y="35" width="255" height="150" as="geometry"/></mxCell><mxCell id="shared" value="Global  (rg-dnsfo-shared)" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#323130;container=1;collapsible=0;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1490" y="80" width="290" height="560" as="geometry"/></mxCell><mxCell id="pz_azure" value="&lt;b&gt;azure.contoso.internal&lt;/b&gt;&lt;br&gt;app1 → 10.50.0.1" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/DNS_Zones.svg" vertex="1" parent="shared"><mxGeometry x="120" y="40" width="44" height="44" as="geometry"/></mxCell><mxCell id="pz_pl" value="&lt;b&gt;privatelink.blob.core.windows.net&lt;/b&gt;&lt;br&gt;private endpoint A records" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/DNS_Zones.svg" vertex="1" parent="shared"><mxGeometry x="120" y="150" width="44" height="44" as="geometry"/></mxCell><mxCell id="pz_lab" value="&lt;b&gt;lab.contoso.internal&lt;/b&gt; (test zone)&lt;br&gt;r1 copy: whoami → 10.255.1.1&lt;br&gt;r2 copy: whoami → 10.255.2.2" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/DNS_Zones.svg" vertex="1" parent="shared"><mxGeometry x="120" y="260" width="44" height="44" as="geometry"/></mxCell><mxCell id="shared_n" value="Private DNS zones are global. Link each zone to BOTH hub VNets — only the inbound endpoint that receives the query has to be healthy.&lt;br&gt;&lt;br&gt;The per-region &lt;b&gt;lab.&lt;/b&gt; zone copies let every probe record which region answered." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#323130;fontColor=#605E5C;fontStyle=2;" vertex="1" parent="shared"><mxGeometry x="15" y="390" width="260" height="150" as="geometry"/></mxCell><mxCell id="legend" value="Legend" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#323130;container=1;collapsible=0;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1490" y="660" width="290" height="280" as="geometry"/></mxCell><mxCell id="lg_0_t" value="primary DNS path" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#323130;verticalAlign=middle;" vertex="1" parent="legend"><mxGeometry x="80" y="40" width="200" height="22" as="geometry"/></mxCell><mxCell id="lg_1_t" value="secondary DNS path (failover)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#323130;verticalAlign=middle;" vertex="1" parent="legend"><mxGeometry x="80" y="70" width="200" height="22" as="geometry"/></mxCell><mxCell id="lg_2_t" value="VNet peering / hybrid link" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#323130;verticalAlign=middle;" vertex="1" parent="legend"><mxGeometry x="80" y="100" width="200" height="22" as="geometry"/></mxCell><mxCell id="lg_3_t" value="private DNS zone link" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#323130;verticalAlign=middle;" vertex="1" parent="legend"><mxGeometry x="80" y="130" width="200" height="22" as="geometry"/></mxCell><mxCell id="lg_4_t" value="on-prem client → local DNS" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#323130;verticalAlign=middle;" vertex="1" parent="legend"><mxGeometry x="80" y="160" width="200" height="22" as="geometry"/></mxCell><mxCell id="lg_f1a" value="F1a" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D13438;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=9;shadow=1;" vertex="1" parent="legend"><mxGeometry x="15" y="200" width="26" height="26" as="geometry"/></mxCell><mxCell id="lg_f1a_t" value="Emulated outage: NSG deny-all on IE1 subnet" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#323130;verticalAlign=middle;" vertex="1" parent="legend"><mxGeometry x="47" y="200" width="235" height="26" as="geometry"/></mxCell><mxCell id="lg_lb" value="LB" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D13438;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=9;shadow=1;" vertex="1" parent="legend"><mxGeometry x="15" y="235" width="26" height="26" as="geometry"/></mxCell><mxCell id="lg_lb_t" value="Emulated link break: Location 1 ↔ hub r1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#323130;verticalAlign=middle;" vertex="1" parent="legend"><mxGeometry x="47" y="235" width="235" height="26" as="geometry"/></mxCell><mxCell id="flow" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8C6C4;" vertex="1" parent="1"><mxGeometry x="20" y="960" width="1760" height="125" as="geometry"/></mxCell><mxCell id="st_1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="985" width="34" height="34" as="geometry"/></mxCell><mxCell id="st_1_t" value="&lt;b style='font-size:12px'&gt;Normal operation&lt;/b&gt;&lt;br&gt;Each client queries its preferred inbound endpoint (spoke B → IE1). The other endpoint is a hot standby that serves the same zones." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#323130;fontSize=11;" vertex="1" parent="1"><mxGeometry x="85" y="975" width="520" height="100" as="geometry"/></mxCell><mxCell id="st_2" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="625" y="985" width="34" height="34" as="geometry"/></mxCell><mxCell id="st_2_t" value="&lt;b style='font-size:12px'&gt;Failover&lt;/b&gt;&lt;br&gt;IE1 or region r1 becomes unreachable. The client's own resolver times out and retries the next listed server (IE2). Measured: Linux ≈5 s, Windows 17–56 s, BIND ≈ one query timeout." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#323130;fontSize=11;" vertex="1" parent="1"><mxGeometry x="670" y="975" width="520" height="100" as="geometry"/></mxCell><mxCell id="st_3" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1210" y="985" width="34" height="34" as="geometry"/></mxCell><mxCell id="st_3_t" value="&lt;b style='font-size:12px'&gt;Failback&lt;/b&gt;&lt;br&gt;When IE1 recovers, Linux returns to IE1 on the next query; Windows and BIND return after their server-health timers expire. No DNS or VNet configuration changes are needed." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#323130;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1255" y="975" width="520" height="100" as="geometry"/></mxCell><mxCell id="f1a" value="F1a" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D13438;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=9;shadow=1;" vertex="1" parent="1"><mxGeometry x="916" y="200" width="28" height="28" as="geometry"/></mxCell><mxCell id="flb" value="LB" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D13438;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=9;shadow=1;" vertex="1" parent="1"><mxGeometry x="531" y="456" width="28" height="28" as="geometry"/></mxCell><mxCell id="e_cli_op1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#5C2D91;fontColor=#5C2D91;strokeWidth=1.5;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="cli_op1" target="bind_op1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="325" y="390"/><mxPoint x="325" y="236"/></Array></mxGeometry></mxCell><mxCell id="e_cli_op2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#5C2D91;fontColor=#5C2D91;strokeWidth=1.5;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="cli_op2" target="bind_op2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="325" y="790"/><mxPoint x="325" y="636"/></Array></mxGeometry></mxCell><mxCell id="lg_0" value="" style="html=1;strokeWidth=2;strokeColor=#0078D4;e