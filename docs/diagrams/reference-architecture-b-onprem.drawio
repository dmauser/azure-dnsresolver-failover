;startArrow=block;startFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="880" as="sourcePoint"/><mxPoint x="570" y="880" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l_c_h2" value="" style="html=1;strokeWidth=3;strokeColor=#605E5C;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="880" as="sourcePoint"/><mxPoint x="800" y="880" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e_sb_h1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#605E5C;fontColor=#605E5C;strokeWidth=2;exitX=0;exitY=0.85;entryX=1;entryY=0.85;startArrow=block;startFill=1;" edge="1" parent="1" source="spokeb" target="hub1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_sb_h2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#605E5C;fontColor=#605E5C;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.92;entryY=0;startArrow=block;startFill=1;" edge="1" parent="1" source="spokeb" target="hub2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1327" y="510"/><mxPoint x="1150" y="510"/></Array></mxGeometry></mxCell><mxCell id="e_b1_ie1" value="primary" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#0078D4;fontColor=#0078D4;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bind_op1" target="ie1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_b1_ie2" value="secondary" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#CA5010;fontColor=#CA5010;strokeWidth=2;dashed=1;exitX=1;exitY=0.8;entryX=0;entryY=0.85;" edge="1" parent="1" source="b