<mxfile host="drawio" type="device"><diagram id="refarch-b" name="Design B with on-premises"><mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style='font-size:20px'&gt;Recommended reference architecture — Design B: DNS Private Resolver regional failover with on-premises&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#605E5C'&gt;Every DNS client (on-premises DNS servers and Azure VNets) lists BOTH resolver inbound endpoints. Failover and failback are performed by the client — no Azure-side reconfiguration.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1760" height="55" as="geometry"/></mxCell><mxCell id="onprem" value="On-premises  (emulated: 2 VNets · rg-dnsfo-onprem1 / 2)" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#F7F4FB;strokeColor=#5C2D91;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#323130;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="500" height="860" as="geometry"/></mxCell><mxCell id="site_op1" value="Location 1 · vnet-dnsfo-op1 · 10.110.0.0/16" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=52;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#201F1E;container=1;collapsible=0;" vertex="1" parent="onprem"><mxGeometry x="20" y="40" width="460" height="390" as="geometry"/></mxCell><mxCell id="site_op1_ic" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Virtual_Networks.svg" vertex="1" parent="site_op1"><mxGeometry x="10" y="8" width="34" height="34" as="geometry"/></mxCell><mxCell id="cfg_op1" value="&lt;b&gt;named.conf (excerpt)&lt;/b&gt;&lt;br&gt;&lt;font face='Consolas'&gt;zone &quot;azure.contoso.internal&quot;&lt;br&gt;zone &quot;privatelink.blob.core.windows.net&quot;&lt;br&gt;zone &quot;lab.contoso.internal&quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;type forward; forward only;&lt;br&gt;&amp;nbsp;&amp;nbsp;forwarders { 10.10.0.4; 10.20.0.4; };&lt;/font&gt;&lt;br&gt;&lt;br&gt;Authoritative: &lt;b&gt;op1.onprem.contoso.internal&lt;/b&gt;&lt;br&gt;max-cache-ttl 5 s · querylog on" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8886;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#323130;strokeColor=#5C2D91;" vertex="1" parent="site_op1"><mxGeometry x="15" y="55" width="235" height="200" as="geometry"/></mxCell><mxCell id="note_op1" value="&lt;i&gt;BIND tries forwarders by measured RTT (not list order) and marks unresponsive ones down — both endpoints carry load; failover is automatic.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#323130;fontColor=#605E5C;" vertex="1" parent="site_op1"><mxGeometry x="15" y="270" width="235" height="70" as="geometry"/></mxCell><mxCell id="site_op1_sn" value="&lt;b&gt;snet-servers&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5FAFF;strokeColor=#8A8886;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=10;fontColor=#323130;container=1;collapsible=0;" vertex="1" parent="site_op1"><mxGeometry x="265" y="55" width="180" height="315" as="geometry"/></mxCell><mxCell id="bind_op1" value="&lt;b&gt;vm-dnsfo-bind-op1&lt;/b&gt;&lt;br&gt;BIND 9 DNS server&lt;br&gt;10.110.0.10" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Virtual_Machine.svg" vertex="1" parent="site_op1_sn"><mxGeometry x="68" y="39" width="44" height="44" as="geometry"/></mxCell><mxCell id="cli_op1" value="&lt;b&gt;vm-dnsfo-lnx-op1&lt;/b&gt;&lt;br&gt;client · probe&lt;br&gt;resolv.conf → 10.110.0.10" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Virtual_Machine.svg" vertex="1" parent="site_op1_sn"><mxGeometry x="70" y="195" width="40" height="40" as="geometry"/></mxCell><mxCell id="site_op2" value="Location 2 · vnet-dnsfo-op2 · 10.120.0.0/16" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=52;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#201F1E;container=1;collapsible=0;" vertex="1" parent="onprem"><mxGeometry x="20" y="440" width="460" height="390" as="geometry"/></mxCell><mxCell id="site_op2_ic" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Virtual_Networks.svg" vertex="1" parent="site_op2"><mxGeometry x="10" y="8" width="34" height="34" as="geometry"/></mxCell><mxCell id="cfg_op2" value="&lt;b&gt;named.conf (excerpt)&lt;/b&gt;&lt;br&gt;&lt;font face='Consolas'&gt;zone &quot;azure.contoso.internal&quot;&lt;br&gt;zone &quot;privatelink.blob.core.windows.net&quot;&lt;br&gt;zone &quot;lab.contoso.internal&quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;type forward; forward only;&lt;br&gt;&amp;nbsp;&amp;nbsp;forwarders { 10.20.0.4; 10.10.0.4; };&lt;/font&gt;&lt;br&gt;&lt;br&gt;Authoritative: &lt;b&gt;op2.onprem.contoso.internal&lt;/b&gt;&lt;br&gt;max-cache-ttl 5 s · querylog on" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8886;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#323130;strokeColor=#5C2D91;" vertex="1" parent="site_op2"><mxGeometry x="15" y="55" width="235" height="200" as="geometry"/></mxCell><mxCell id="note_op2" value="&lt;i&gt;BIND tries forwarders by measured RTT (not list order) and marks unresponsive ones down — both endpoints carry load; failover is automatic.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#323130;fontColor=#605E5C;" vertex="1" parent="site_op2"><mxGeometry x="15" y="270" width="235" height="70" as="geometry"/></mxCell><mxCell id="site_op2_sn" value="&lt;b&gt;snet-servers&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5FAFF;strokeColor=#8A8886;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=10;fontColor=#323130;container=1;collapsible=0;" vertex="1" parent="site_op2"><mxGeometry x="265" y="55" width="180" height="315" as="geometry"/></mxCell><mxCell id="bind_op2" value="&lt;b&gt;vm-dnsfo-bind-op2&lt;/b&gt;&lt;br&gt;BIND 9 DNS server&lt;br&gt;10.120.0.10" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Virtual_Machine.svg" vertex="1" parent="site_op2_sn"><mxGeometry x="68" y="39" width="44" height="44" as="geometry"/></mxCell><mxCell id="cli_op2" value="&lt;b&gt;vm-dnsfo-lnx-op2&lt;/b&gt;&lt;br&gt;client · probe&lt;br&gt;resolv.conf → 10.120.0.10" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Virtual_Machine.svg" vertex="1" parent="site_op2_sn"><mxGeometry x="70" y="195" width="40" height="40" as="geometry"/></mxCell><mxCell id="conn" value="&lt;b&gt;Hybrid connectivity&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8886;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#323130;fillColor=#F3F2F1;strokeColor=#8A8886;strokeWidth=1.5;dashed=1;align=center;spacingLeft=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="570" y="120" width="170" height="790" as="geometry"/></mxCell><mxCell id="conn_t" value="&lt;b&gt;Lab default:&lt;/b&gt; VNet peering&lt;br&gt;each location ↔ hub r1 &lt;u&gt;and&lt;/u&gt; hub r2&lt;br&gt;&lt;br&gt;&lt;b&gt;Lab option:&lt;/b&gt; VPN Gateway S2S + BGP&lt;br&gt;(-Connectivity Vpn)&lt;br&gt;&lt;br&gt;&lt;b&gt;Production:&lt;/b&gt; ExpressRoute and/or S2S VPN to BOTH regions" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#323130;align=center;" vertex="1" parent="1"><mxGeometry x="575" y="720" width="160" height="130" as="geometry"/></mxCell><mxCell id="conn_ic" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Virtual_Network_Gateways.svg" vertex="1" parent="1"><mxGeometry x="638" y="855" width="34" height="34" as="geometry"/></mxCell><mxCell id="reg1" value="Azure region r1 · East US 2  (rg-dnsfo-r1)" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#323130;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="780" y="80" width="690" height="420" as="geometry"/></mxCell><mxCell id="hub1" value="vnet-dnsfo-hub-r1 · 10.10.0.0/22" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=52;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#201F1E;container=1;collapsible=0;" vertex="1" parent="reg1"><mxGeometry x="20" y="35" width="380" height="370" as="geometry"/></mxCell><mxCell id="hub1_ic" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Virtual_Networks.svg" vertex="1" parent="hub1"><mxGeometry x="10" y="7" width="34" height="34" as="geometry"/></mxCell><mxCell id="dnspr1" value="&lt;b&gt;dnspr-dnsfo-r1&lt;/b&gt;" style="image;